# PhotoFlow backend — environment configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in your own values.
#
#     copy backend\.env.example backend\.env      (Windows)
#     cp backend/.env.example backend/.env        (macOS / Linux)
#
# backend/.env is git-ignored. NEVER commit real values: this repository has a
# public remote, and a secret committed even once stays in the history forever —
# a later deletion does not undo the exposure.
#
# NONE of these values may ever be shipped inside the PhotoFlow desktop
# installer. The desktop app knows exactly two things about the backend: the
# public API base URL, and (later) the Ed25519 *public* key used to verify
# entitlement tokens. It must never hold a database URL, a JWT secret, or an
# admin token.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
# "production" turns on strict validation: placeholder secrets, DEBUG, wildcard
# CORS and a non-HTTPS API base URL all refuse to start.
PHOTOFLOW_ENVIRONMENT=development
PHOTOFLOW_DEBUG=true

# ── Database ────────────────────────────────────────────────────────────────
# BACKEND ONLY. This is the single most sensitive value in the project.
#
# Local PostgreSQL:
PHOTOFLOW_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/photoflow_dev
#
# Neon (development branch) — copy the pooled connection string from the Neon
# console and keep ?sslmode=require:
# PHOTOFLOW_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-dev.region.aws.neon.tech/photoflow?sslmode=require
#
# The production branch URL belongs in the hosting provider's secret store —
# not in this file, and not on your laptop.

# ── HTTP ────────────────────────────────────────────────────────────────────
PHOTOFLOW_API_BASE_URL=http://localhost:8000

# Comma-separated, explicit origins only. "*" is refused in production.
# The desktop app is not a browser and is unaffected by CORS; this exists for
# the local admin dashboard, which is the only browser origin that should ever
# call this API.
PHOTOFLOW_CORS_ORIGINS=http://localhost:8787

# ── Tokens ──────────────────────────────────────────────────────────────────
# Generate a real one for anything other than local development:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
PHOTOFLOW_JWT_SECRET=dev-only-insecure-change-me
PHOTOFLOW_ACCESS_TOKEN_TTL_MINUTES=30
PHOTOFLOW_REFRESH_TOKEN_TTL_DAYS=30

# ── Feature flags ───────────────────────────────────────────────────────────
# Credits: schema exists, behaviour is off until pricing is validated.
PHOTOFLOW_CREDITS_ENABLED=false

# ── Logging ─────────────────────────────────────────────────────────────────
PHOTOFLOW_LOG_LEVEL=INFO
# true in production, so a hosted log search can filter on request_id.
PHOTOFLOW_LOG_JSON=false

# ── Tests ───────────────────────────────────────────────────────────────────
# A THROWAWAY database. The test suite drops and rebuilds its schema, and it
# deliberately does NOT fall back to PHOTOFLOW_DATABASE_URL — if this is unset
# the database-backed tests skip rather than guess.
PHOTOFLOW_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/photoflow_test
