# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/

# Runtime artifacts (created by the app, not part of the repo)
logs/*.log
logs/*.log.*
data/cache.db
data/collage_presets.json

# Build output (packaging/build.bat). Never commit installers or frozen builds:
# they're hundreds of MB and git keeps every version forever. Publish them as
# GitHub Release assets instead -- see docs/SHIPPING_PLAN.md.
build/
dist/
packaging/output/
packaging/version_info.txt

# The installer the website links to is a release asset, not a repo file.
website/downloads/*.exe

# API keys and build secrets — never commit these.
# This repo has a public remote, and anything committed once stays in git
# history forever, so a later deletion does not undo the exposure.
.env
utils/_secrets.py

# Backend secrets. backend/.env holds the PostgreSQL/Neon connection string and
# the JWT signing secret — the two most damaging values in the project, and the
# only copy of them that ever sits on a developer's disk. backend/.env.example is
# the committed template.
backend/.env
backend/.env.*
!backend/.env.example

# The backend's virtual environment is separate from the desktop app's, so that
# a backend dependency upgrade can never break an installer build.
.venv-backend/

# Alembic emits SQL here when run with --sql; it contains real schema and,
# depending on the command, real data.
backend/*.sql

# Scratch directory used when delivering files onto this machine.
_to_delete/

# OS / editor cruft
.DS_Store
.vscode/
.idea/
.venv-release/