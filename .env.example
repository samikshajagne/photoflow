# PhotoFlow environment variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env (same directory) and fill in your actual key.
# .env is git-ignored; never commit real keys to version control.
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API key — required for GPT-4o Vision scene understanding.
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
